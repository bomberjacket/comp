[
  {
    "id": "frk_pt_128039a155273c7783165d34",
    "name": "Cyber Incident Response Plan (water utility, AWWA CIRP structure)",
    "description": "Cyber incident response plan structured after the AWWA 2025 Cyber Incident Response Plan template: response team, detection, severity matrix, action checklist and post-incident actions. Backs the Detect, Respond and Recover goals and the written-plan item of the EPA checklist (2.S). Part of the Water and Wastewater Cybersecurity (EPA checklist on CISA CPG 2.0).",
    "frequency": "yearly",
    "department": "it",
    "content": {
      "type": "doc",
      "content": [
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "text": "Purpose"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "text": "This document is {{COMPANY}}'s cyber incident response plan, maintained under the Water and Wastewater Cybersecurity (EPA checklist on CISA CPG 2.0)."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "text": "Incident Response Team"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Roles, alternates, 24x7 contact methods (including when primary communications are down); integrator/MSP and vendor contacts; legal, insurer, public information."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "text": "Detecting an Incident"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Sources of alerts (logs 2.T/2.U, malicious code detection, operator observations); how staff report suspected incidents and phishing; threat and TTP list in use (3.A)."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "text": "Severity Matrix"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Severity levels tied to effects on water or wastewater service, public health and safety, and data; who declares each level."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "text": "Cyber-Incident Action Checklist"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Containment steps for OT and IT; manual operations; evidence preservation and chain of custody; notifications to EPA, CISA, state primacy agency, law enforcement and customers (4.A); vendor and MSP engagement."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "text": "Post Incident Actions"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Recovery and restoration from backups with integrity checks (5.A); criteria for declaring the incident closed."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "text": "Evidence Retention"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "What is retained, where, for how long, and who may release it."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "text": "Lessons Learned / After Action Report (AAR)"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "AAR within 30 days; tabletop exercises at least annually (CISA water CTEP) with senior leadership."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "text": "Implementing Improvements/Corrective Actions"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Corrective action tracker with owners and dates; feed into the risk management plan."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "text": "Source"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "text": "Structure after the AWWA Cybersecurity Risk Management Plan and Cyber Incident Response Plan templates (American Water Works Association, 2025 v1, https://www.awwa.org/cybersecurity); section prompts by BomberJacket Networks. Replace the prompts with the utility's own text."
            }
          ]
        }
      ]
    }
